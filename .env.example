# ---------------------------------------------------------------------------
# IEEE SPS Committee Copilot — copy this file to .env and fill in what you use.
# Every key below is OPTIONAL. With none of them set the app still runs:
# tracking, scoring and the deadline radar are pure-Python and need no keys.
# ---------------------------------------------------------------------------

# --- Who you are (drives fit scoring + outreach letter signatures) ----------
CHAPTER_NAME=IEEE Signal Processing Society Student Branch Chapter
INSTITUTION=Your Institute of Technology
CITY=Your City
COUNTRY=India
IEEE_REGION=10
IEEE_SECTION=Your IEEE Section
CHAIR_NAME=Your Name
CHAIR_EMAIL=you@example.com

# Rough seating capacity of the largest hall you can offer a conference.
# Used to flag conferences your campus physically cannot host.
VENUE_CAPACITY=500

# --- LLM (advisor chat, outreach drafts, playbooks) -------------------------
# LLM_PROVIDER: gemini | claude | none
#   none = rules-only mode. Everything still works, feedback is just terser.
LLM_PROVIDER=gemini

GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest

# Free-tier guardrails. Your Google AI Studio free tier is roughly 5 requests
# per minute and a small daily cap, so the client self-throttles and caches.
# Set GEMINI_MAX_RPM=0 to disable throttling on a paid plan.
GEMINI_MAX_RPM=5
GEMINI_MAX_RETRIES=1

# Only needed when LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5

# --- Telegram alerts (instant high-fit flags + weekly digest) ---------------
# Create a bot with @BotFather, add it to your committee group, then use
# the /chatid command in this app's dashboard to find the group id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Email digest -----------------------------------------------------------
# For Gmail use an App Password, not your account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
DIGEST_TO=

# --- Scheduling -------------------------------------------------------------
# Daily crawl hour (24h local time) and weekly digest day (0=Mon .. 6=Sun).
CRAWL_HOUR=7
DIGEST_DAY=0
DIGEST_HOUR=9

# Conferences scoring at or above this fit score trigger an instant alert.
ALERT_THRESHOLD=70

# Where the SQLite file lives.
DB_FILE=sps_copilot.db
